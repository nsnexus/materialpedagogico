# Gateway Pix do NSMusic (NSNexus Pay) — ver nsmusic/docs/GATEWAY_INTEGRATION.md
NSNEXUS_GATEWAY_URL=https://nsmusic.nsnexus.com.br
NSNEXUS_GATEWAY_API_KEY=mesma_chave_GATEWAY_API_KEY_do_nsmusic

# Assinatura do cookie de login (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Domínio do site (imagem de prévia no WhatsApp/Facebook)
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Opcional: só para `scripts/subir-acervo.mjs --s3` (R2 > Manage API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bau-acervo

# Só em desenvolvimento: simula um Pix pago 8s depois de gerado
# DEV_PIX_FAKE=1
